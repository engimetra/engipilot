// ═══════════════════════════════════════════════════════════════
//  ENGIPILOT — Prisma Schema Complet
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum Plan { STARTER; PRO; ENTERPRISE }
enum ProjectStatus { ACTIVE; PAUSED; COMPLETED; CANCELLED }
enum ProjectType { CONSTRUCTION; RENOVATION; INFRASTRUCTURE; INDUSTRIAL; OTHER }
enum SiteStatus { ACTIVE; PAUSED; COMPLETED; CLOSED }
enum TaskStatus { TODO; IN_PROGRESS; REVIEW; DONE; BLOCKED }
enum Priority { LOW; MEDIUM; HIGH; CRITICAL }
enum WorkerStatus { ACTIVE; INACTIVE; ON_LEAVE }
enum AttendanceStatus { PRESENT; ABSENT; LATE; HALF_DAY; ON_LEAVE }
enum EquipmentStatus { AVAILABLE; IN_USE; MAINTENANCE; OUT_OF_SERVICE }
enum BudgetType { GENERAL; LABOR; MATERIALS; EQUIPMENT; OVERHEAD; SUBCONTRACTOR }
enum BudgetStatus { DRAFT; APPROVED; ACTIVE; CLOSED }
enum ExpenseStatus { PENDING; APPROVED; REJECTED; PAID }
enum DocumentType { PLAN; CONTRACT; REPORT; PHOTO; NC; PV; HSE; OTHER }
enum IncidentType { ACCIDENT; NEAR_MISS; NON_CONFORMITY; OBSERVATION; ENVIRONMENTAL }
enum Severity { LOW; MEDIUM; HIGH; CRITICAL }
enum IncidentStatus { OPEN; UNDER_INVESTIGATION; RESOLVED; CLOSED }
enum AiMode { CHAT; PV; RAPPORT; RISQUES }
enum AlertLevel { LOW; MEDIUM; HIGH; CRITICAL }
enum NotificationType { INFO; WARNING; ERROR; SUCCESS; AI_ALERT }
enum ReportType { DAILY_PROGRESS; WEEKLY_SUMMARY; MONTHLY_KPI }
enum ReportGenerator { MANUAL; AI }

// ─────────────────────────────────────────────────────────────
//  MODÈLES
// ─────────────────────────────────────────────────────────────

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  firstName       String
  lastName        String
  avatar          String?
  phone           String?
  status          UserStatus       @default(ACTIVE)
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  roleId          String
  role            Role             @relation(fields: [roleId], references: [id])
  projectMembers  ProjectMember[]
  assignedTasks   Task[]           @relation("assignedTasks")
  createdTasks    Task[]           @relation("TaskCreator")
  attendance      Attendance[]
  aiConversations AiConversation[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  uploadedDocs    Document[]
  reports         Report[]

  @@map("users")
}

model Role {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
  @@map("roles")
}

model Company {
  id       String    @id @default(uuid())
  name     String
  users    User[]
  projects Project[]
  @@map("companies")
}

model Project {
  id       String    @id @default(uuid())
  name     String
  companyId String
  company  Company   @relation(fields: [companyId], references: [id])
  @@map("projects")
}

model ProjectMember {
  id        String  @id @default(uuid())
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
  @@map("project_members")
}

model Task {
  id         String @id @default(uuid())
  title      String
  projectId  String
  assigneeId String?
  project    Project @relation(fields: [projectId], references: [id])
  assignee   User?   @relation("assignedTasks", fields: [assigneeId], references: [id])
  @@map("tasks")
}

model Attendance {
  id       String @id @default(uuid())
  workerId String
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  @@map("attendance")
}

model AiConversation {
  id     String      @id @default(uuid())
  userId String
  user   User        @relation(fields: [userId], references: [id])
  messages AiMessage[]
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id])
  @@map("ai_messages")
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  @@map("notifications")
}

model ActivityLog {
  id     String @id @default(uuid())
  userId String?
  user   User?  @relation(fields: [userId], references: [id])
  @@map("activity_logs")
}

model Document {
  id           String @id @default(uuid())
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  @@map("documents")
}

model Report {
  id       String @id @default(uuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  @@map("reports")
}