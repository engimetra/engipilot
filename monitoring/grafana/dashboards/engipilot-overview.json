{
  "title": "ENGIPILOT — Vue d'ensemble",
  "uid": "engipilot-overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["engipilot", "infrastructure", "overview"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Utilisation CPU (%)",
      "description": "Pourcentage d'utilisation CPU hôte (toutes cœurs confondus)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU — {{instance}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Mémoire disponible",
      "description": "Mémoire RAM disponible sur l'hôte",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 536870912 },
              { "color": "green", "value": 1073741824 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "Mémoire dispo — {{instance}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Taux de requêtes HTTP — Backend",
      "description": "Nombre de requêtes HTTP par seconde reçues par le backend Spring Boot",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"engipilot-backend\"}[5m]))",
          "legendFormat": "Requêtes/s",
          "refId": "A"
        },
        {
          "expr": "up{job=\"engipilot-backend\"}",
          "legendFormat": "Backend UP",
          "refId": "B",
          "hide": false
        }
      ],
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Redémarrages conteneurs",
      "description": "Nombre total de redémarrages des conteneurs Docker depuis 1h",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "increase(container_restart_count{name=~\"engipilot-.*\"}[1h])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Espace disque disponible",
      "description": "Espace disque disponible sur les partitions montées",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 5368709120 },
              { "color": "green", "value": 10737418240 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\",mountpoint=\"/\"}",
          "legendFormat": "Dispo — {{mountpoint}} ({{instance}})",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Connexions PostgreSQL actives",
      "description": "Nombre de connexions actives sur la base de données PostgreSQL",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 45 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"engipilot\"}",
          "legendFormat": "Connexions — {{state}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus" }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 2
      }
    ]
  }
}
